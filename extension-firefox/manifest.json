{
  "manifest_version": 3,
  "name": "Subtle",
  "version": "0.11.0",
  "description": "A universal open-source video subtitle extension. Real-time subtitles and translation for any video, generated locally on your own GPU. (Firefox version: Experimental)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "offscreen.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subtle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "substyle.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-subs": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or stop subtitles on the current tab"
    },
    "hide-subs": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Hide or show the subtitles"
    },
    "repeat-line": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Show the last line again"
    },
    "catch-up": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Catch me up: a short summary of the last few minutes"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "subtle@ddsaamir.github.io",
      "strict_min_version": "128.0"
    }
  }
}
